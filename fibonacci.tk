.code
; take user input and store in r1
	ld r11, 0
	in r1, r11
; set output register
	ld r10, 1
; initialize fib values
	ld r2, 0
	ld r3, 1
; constants for comparison
	ld r5, 1
	ld r6, 2
; check if n == 1
	sub r7, r1, r5
	ld r20, :checktwo
	brnz r20, r7
; if n == 1 output 0
	out r10, r2
	halt
:checktwo
; check if n == 2
	sub r7, r1, r6
	ld r20, :init
	brnz r20, r7
; if n == 2 output 1
	out r10, r3
	halt
:init
; prepare loop counter = n - 2
	subi r1, 2
:loop
; next = prev + curr
	add r4, r2, r3
; shift values forward
	mov r2, r3
	mov r3, r4
; decrement counter
	subi r1, 1
; repeat loop if counter != 0
	ld r20, :loop
	brnz r20, r1
; output result
	out r10, r3
	halt