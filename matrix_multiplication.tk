.code
; initialize input port number
	ld r19, 0
; initialize output port number
	ld r18, 2
; read dimension n
	in r1, r19
; store n in r1, set loop bound as n-1 is handled by comparison
; set base addresses for A, B, C
	ld r8, 65536
; compute n*n
	mul r2, r1, r1
; compute n*n*8
	ld r3, 8
	mul r4, r2, r3
; base of B = base of A + n*n*8
	add r9, r8, r4
; base of C = base of B + n*n*8
	add r10, r9, r4
; read in matrix A elements
	clr r5
:inputA
	in r6, r19
	mul r7, r5, r3
	add r7, r8, r7
	mov (r7)(0), r6
	addi r5, 1
	sub r7, r2, r5
	ld r20, :inputA
	brnz r20, r7
; read in matrix B elements
	clr r5
:inputB
	in r6, r19
	mul r7, r5, r3
	add r7, r9, r7
	mov (r7)(0), r6
	addi r5, 1
	sub r7, r2, r5
	ld r20, :inputB
	brnz r20, r7
; i = 0
	clr r11
; outer loop over i
:loopi
; j = 0
	clr r12
; middle loop over j
:loopj
; C[i][j] = 0.0
	clr r13
; k = 0
	clr r14
; inner loop over k
:loopk
; compute address of A[i][k]: (i*n + k) * 8 + base_A
	mul r15, r11, r1
	add r15, r15, r14
	mul r15, r15, r3
	add r15, r8, r15
	mov r15, (r15)(0)
; compute address of B[k][j]: (k*n + j) * 8 + base_B
	mul r16, r14, r1
	add r16, r16, r12
	mul r16, r16, r3
	add r16, r9, r16
	mov r16, (r16)(0)
; C[i][j] += A[i][k] * B[k][j]
	mulf r17, r15, r16
	addf r13, r13, r17
; k++, loop if k < n
	addi r14, 1
	sub r7, r1, r14
	ld r20, :loopk
	brnz r20, r7
; store C[i][j]: (i*n + j) * 8 + base_C
	mul r15, r11, r1
	add r15, r15, r12
	mul r15, r15, r3
	add r15, r10, r15
	mov (r15)(0), r13
; j++, loop if j < n
	addi r12, 1
	sub r7, r1, r12
	ld r20, :loopj
	brnz r20, r7
; i++, loop if i < n
	addi r11, 1
	sub r7, r1, r11
	ld r20, :loopi
	brnz r20, r7
; output C row by row
	clr r5
:outputloop
	mul r7, r5, r3
	add r7, r10, r7
	mov r6, (r7)(0)
	out r18, r6
	addi r5, 1
	sub r7, r2, r5
	ld r20, :outputloop
	brnz r20, r7
; halt
	halt
.data
	0